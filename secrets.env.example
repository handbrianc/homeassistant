# =============================================================================
# Home Assistant secrets -> Kubernetes Secret "<RELEASE_NAME>-secrets"
# Copy to secrets.env, fill in what you need, then run scripts/install.sh.
#
# secrets.env is git-ignored. Every non-comment KEY=VALUE line becomes an
# environment variable inside the Home Assistant container (12-factor: config
# via environment). Reference values in configuration.yaml with:
#
#     recorder:
#       db_url: !env_var HASS_RECORDER_DB_URL
#
# The examples below are commented out — uncomment and fill in what you use.
# =============================================================================

# Optional external recorder database (recommended over SQLite on the PVC
# for heavy setups; point it at PostgreSQL/MariaDB running in or out of cluster)
# HASS_RECORDER_DB_URL=postgresql://homeassistant:changeit@postgres.homeassistant.svc.cluster.local:5432/homeassistant?sslmode=disable

# Example: MQTT broker credentials
# MQTT_USERNAME=homeassistant
# MQTT_PASSWORD=changeit

# Example: integration API tokens
# INFLUXDB_TOKEN=changeit
# NEST_PASSWORD=changeit
