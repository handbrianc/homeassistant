#!/bin/sh
# Mock kubectl (tests/stubs/). Logs every call to $HC_STUB_LOG and serves
# canned go-template/jsonpath outputs. NEVER a real binary: tests put this
# FIRST on PATH inside env -i, so a real cluster can never be reached.
# Knobs: HC_STUB_ARCHS, HC_STUB_NO_LB=1, HC_STUB_NO_INGRESS=1, HC_STUB_NO_PVC=1,
#        HC_STUB_NO_RELEASE=1 (also blanks the StatefulSet image), HC_STUB_NO_STS=1,
#        HC_STUB_NODES_FAIL=1, HC_STUB_ROLLOUT_FAIL=1,
#        HC_STUB_SVC_MODE=lb|pending|nodeport|none.
echo "kubectl $*" >> "${HC_STUB_LOG:?}"
case "$*" in
  *'.status.nodeInfo.architecture'*)
    printf '%b' "${HC_STUB_ARCHS:-arm64\narm64\n}"
    ;;
  *'is-default-class'*)
    printf 'local-path\n'
    ;;
  *'eq .spec.type "LoadBalancer"'*)
    if [ "${HC_STUB_NO_LB:-0}" = "1" ]; then :; else printf '10.0.0.5  \n'; fi
    ;;
  *'-n kube-system get ds'*)
    if [ "${HC_STUB_NO_LB:-0}" = "1" ]; then :; else printf 'svclb-traefik\n'; fi
    ;;
  *'get ingressclasses'*)
    if [ "${HC_STUB_NO_INGRESS:-0}" = "1" ]; then :; else printf 'traefik\n'; fi
    ;;
  *'get namespace'*)
    exit 0
    ;;
  *'get pvc'*)
    if [ "${HC_STUB_NO_PVC:-0}" = "1" ]; then :; else printf '8Gi\tlonghorn\n'; fi
    ;;
  *'get statefulset'*'jsonpath'*)
    if [ "${HC_STUB_NO_RELEASE:-0}" = "1" ]; then :; else printf 'ghcr.io/home-assistant/home-assistant:2026.10.3\n'; fi
    ;;
  *'get statefulset'*'-o name'*)
    if [ "${HC_STUB_NO_STS:-0}" = "1" ]; then :; else printf 'statefulset.apps/homeassistant-homeassistant\n'; fi
    ;;
  *'rollout status'*)
    if [ "${HC_STUB_ROLLOUT_FAIL:-0}" = "1" ]; then exit 1; fi
    exit 0
    ;;
  *'get secret'*)
    # shellcheck disable=SC2016  # literal go-template snippet being matched
    case "$*" in
      *'range $k'*)
        printf 'MQTT_PASSWORD\nHA_TOKEN\n'
        ;;
      *)
        exit 0
        ;;
    esac
    ;;
  *'get nodes'*)
    if [ "${HC_STUB_NODES_FAIL:-0}" = "1" ]; then exit 1; fi
    exit 0
    ;;
  *'get svc'*)
    case "${HC_STUB_SVC_MODE:-lb}" in
      lb) printf 'NAME TYPE CLUSTER-IP EXTERNAL-IP PORT(S) AGE\nhomeassistant LoadBalancer 10.43.0.10 192.168.1.50 8123:31456/TCP 5s\n' ;;
      pending) printf 'NAME TYPE CLUSTER-IP EXTERNAL-IP PORT(S) AGE\nhomeassistant LoadBalancer 10.43.0.10 <pending> 8123:31456/TCP 5s\n' ;;
      nodeport) printf 'NAME TYPE CLUSTER-IP EXTERNAL-IP PORT(S) AGE\nhomeassistant NodePort 10.43.0.10 <none> 8123:30812/TCP 5s\n' ;;
      *) : ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac
exit 0
