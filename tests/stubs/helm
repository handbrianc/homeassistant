#!/bin/sh
# Mock helm (tests/stubs/). Logs every call to $HC_STUB_LOG and serves canned
# responses. NEVER a real binary: tests put this FIRST on PATH inside env -i.
# Knobs: HC_STUB_HELM_VERSION (default v3.22.1), HC_STUB_HELM_FAIL=1,
#        HC_STUB_TEMPLATE_FAIL=1, HC_STUB_NO_RELEASE=1, HC_STUB_HIST_ONE=1,
#        HC_STUB_HIST_EMPTY=1.
echo "helm $*" >> "${HC_STUB_LOG:?}"
case "$*" in
  *'template'*)
    if [ "${HC_STUB_TEMPLATE_FAIL:-0}" = "1" ]; then exit 1; fi
    exit 0
    ;;
  *'version'*)
    printf '%s\n' "${HC_STUB_HELM_VERSION:-v3.22.1}"
    ;;
  *'list'*)
    if [ "${HC_STUB_NO_RELEASE:-0}" = "1" ]; then
      printf 'NAME\n'
    else
      printf 'NAME\nhomeassistant\n'
    fi
    ;;
  *'history'*)
    if [ "${HC_STUB_HIST_EMPTY:-0}" = "1" ]; then
      :
    elif [ "${HC_STUB_HIST_ONE:-0}" = "1" ]; then
      printf 'REVISION UPDATED STATUS CHART APP VERSION DESCRIPTION\n1 Mon Jan 1 00:00:00 2026 deployed homeassistant-0.1.0 2026.11.0 Install complete\n'
    else
      printf 'REVISION UPDATED STATUS CHART APP VERSION DESCRIPTION\n1 Mon Jan 1 00:00:00 2026 deployed homeassistant-0.1.0 2026.11.0 Install complete\n2 Tue Jan 2 00:00:00 2026 deployed homeassistant-0.1.0 2026.11.0 Upgrade complete\n'
    fi
    ;;
  *'upgrade'*)
    if [ "${HC_STUB_HELM_FAIL:-0}" = "1" ]; then exit 1; fi
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
exit 0
