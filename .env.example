# =============================================================================
# homeassistant-on-k3s — installer configuration
# Copy to .env and adjust. .env is git-ignored; NEVER commit real values.
# Format: plain KEY=VALUE lines (no "export"), comments start with '#'.
# Real credentials go in secrets.env (see secrets.env.example).
# =============================================================================

# --- Kubernetes target --------------------------------------------------------
# Path to a kubeconfig file (empty = kubectl default resolution)
KUBECONFIG=
# Namespace to install into (created when missing)
NAMESPACE=homeassistant

# --- Helm release ---------------------------------------------------------------
RELEASE_NAME=homeassistant
CHART_DIR=charts/homeassistant
HELM_TIMEOUT=10m
# Optional extra values file applied LAST (overrides everything above)
VALUES_EXTRA=

# --- Container image --------------------------------------------------------------
# Pinned Home Assistant version (official image, multi-arch incl. arm64)
IMAGE_TAG=2026.11.0

# --- Workload configuration ---------------------------------------------------------
# Container timezone — exposed to Home Assistant as the TZ environment variable
TIMEZONE=UTC
# Optional: pin scheduling to an architecture via nodeSelector (e.g. arm64)
NODE_ARCH=

# --- Persistence -----------------------------------------------------------------------
# Storage class: empty uses the cluster default (k3s ships "local-path").
# For replicated storage across RPi4 nodes, install longhorn and set it here.
STORAGE_CLASS=
STORAGE_SIZE=5Gi

# --- Exposure -----------------------------------------------------------------------------
# With an ingress controller fronting the pod, SERVICE_TYPE must be ClusterIP
# (install.sh enforces this). Without an ingress: LoadBalancer works out of the
# box on k3s (klipper-lb binds the node IP); use NodePort on clusters without
# a service load balancer.
SERVICE_TYPE=LoadBalancer
SERVICE_PORT=8123
# Optional fixed IP when SERVICE_TYPE=LoadBalancer (e.g. MetalLB)
LOADBALANCER_IP=
# Optional NodePort (30000-32767) when SERVICE_TYPE=NodePort
NODE_PORT=
# Ingress (bootstrap enables this automatically when it detects an ingress
# controller on the cluster; INGRESS_HOST empty = catch-all rule)
INGRESS_ENABLED=false
INGRESS_CLASS=
INGRESS_HOST=
# Ingress TLS — issued by cert-manager only. Set INGRESS_TLS_ISSUER to the
# ClusterIssuer (or Issuer) that should issue the certificate; install.sh
# renders the chart's Certificate resource, which creates & renews the TLS
# Secret INGRESS_TLS_SECRET_NAME (default <release>-tls). INGRESS_TLS_ENABLED
# requires INGRESS_TLS_ISSUER.
INGRESS_TLS_ENABLED=false
INGRESS_TLS_SECRET_NAME=
INGRESS_TLS_ISSUER=
# Optional certificate DNS names (comma-separated) — overrides the default
# (INGRESS_HOST). Use a wildcard for one certificate across services, e.g.:
#   INGRESS_TLS_DNS_NAMES=*.example.com,example.com
INGRESS_TLS_DNS_NAMES=
# Issuer kind for the Certificate (ClusterIssuer when empty; set to Issuer for
# a namespaced issuer)
INGRESS_TLS_ISSUER_KIND=
# CIDRs Home Assistant must trust for X-Forwarded-For — logins through the
# ingress fail with HTTP 400 without it. k3s default pod CIDR: 10.42.0.0/16
INGRESS_TRUSTED_PROXIES=
# Enables mDNS/SSDP/UPnP discovery by binding to the host network of a node
HOST_NETWORK=false

# --- Secrets --------------------------------------------------------------------------------
# Real secrets live in secrets.env (git-ignored). install.sh applies them as a
# Kubernetes Secret named <RELEASE_NAME>-secrets and exposes them to Home
# Assistant as environment variables. Reference them in configuration.yaml with:
#   password: !env_var MQTT_PASSWORD
SECRETS_FILE=secrets.env
